# Copy this file to .env and fill in your values.
# The adaptation scripts load .env automatically from the repository root.

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for: model_gpt4o.py, Framework phases 3/4/6/7 (GPT-4o judge)
OPENAI_API_KEY=sk-...

# ── Google (Gemini) ──────────────────────────────────────────────────────────
# Path to a service-account JSON with generative-language API access.
# Required for: Framework phase 1 extraction (Gemini 2.5 Flash Lite),
#               phase 7 LLM judge (Gemini 2.5 Pro)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Optional: only needed for gated models (gemma-2-9b-it, llama-3.1-8b)
HF_TOKEN=hf_...
